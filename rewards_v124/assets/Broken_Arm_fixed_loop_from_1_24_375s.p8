__lua__
-- BROKEN ARM v18
-- original selected 0-24s phrase from MIDI (120 BPM)
-- single triangle-wave voice; corrected note choices and sfx timing
-- 32 four-note patterns loop from the beginning; speeds 22/23
function _init()
 music(0)
end
function _update()
 if btnp(4) or btnp(5) then music(0) end
end
function _draw()
 cls(1)
 print("BROKEN ARM v18",23,25,7)
 print("24S LOOP / MIDI 120 BPM",13,49,12)
 print("1 CHANNEL / ORIGINAL MIDI",10,71,7)
 print("Z / X: RESTART",22,103,6)
end
