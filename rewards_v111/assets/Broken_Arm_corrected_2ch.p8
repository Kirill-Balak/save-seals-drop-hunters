pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- faithful adaptation: Broken Arm (source MIDI supplied by user)
-- first 24 seconds, 2 audio channels
-- A/B comparison via separate standalone cartridges
function _init()
 music(0)
end
function _update()
 if btnp(4) or btnp(5) then music(0) end
end
function _draw()
 cls(1)
 print("BROKEN ARM / 2CH",15,27,7)
 print("from original midi",19,45,12)
 print("intro 0:00-0:24",19,58,7)
 print("120 bpm / loop",19,72,6)
 print("z or x: restart",14,99,7)
end
